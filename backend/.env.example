# Local configuration only. Blank keys are sufficient for fake development.
# 开发默认 fake；真实调用必须由部署者在本文件（不提交）填写实际值。
LLM_MODE=fake
LLM_PROVIDER=fake
# --- DeepSeek（默认供应商；real 模式单模型 smoke 只需这三项 + LLM_MODEL_A 可选）---
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# DeepSeek 备用型号（端点/凭证与默认相同；只填模型名即可）。
LLM_MODEL_A=
# --- 智谱 BigModel（GLM）：独立端点与密钥，不填则该条目省略，不影响 DeepSeek ---
LLM_MODEL_B=
LLM_BASE_URL_B=
LLM_API_KEY_B=
# 预留的独立 DeepSeek 备用条目槽（models.yaml 默认未引用；改 env 名即可启用）。
LLM_BASE_URL_A=
LLM_API_KEY_A=
# LLM_MODE=real 时：
# - LLM_PROVIDER=openai_compatible（目前只支持该协议；DeepSeek 与 BigModel 均兼容）
# - DeepSeek：LLM_BASE_URL 为供应商 API base URL（不含 /chat/completions）
# - BigModel：LLM_BASE_URL_B / LLM_API_KEY_B / LLM_MODEL_B 独立配置
# 目录结构见 backend/config/models.yaml；密钥不得提交或发到 Issue/PR。
DATABASE_URL=
SESSION_SECRET=
UPLOAD_DIR=uploads
ALLOWED_ORIGINS=["http://localhost:5173"]
SESSION_TTL_DAYS=7
# False only for local HTTP; set true for an HTTPS deployment.
SESSION_COOKIE_SECURE=false
