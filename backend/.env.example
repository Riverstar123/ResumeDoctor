# Local configuration only. Blank keys are sufficient for fake development.
# 开发默认 fake；真实调用必须由部署者在本文件（不提交）填写实际值。
LLM_MODE=fake
LLM_PROVIDER=fake
LLM_MODEL=fake-default
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_A=
LLM_MODEL_B=
# LLM_MODE=real 时：
# - LLM_PROVIDER=openai_compatible（目前只支持该协议）
# - LLM_BASE_URL 为供应商 API base URL（不含 /chat/completions）
# - LLM_MODEL 为真实默认模型名，LLM_API_KEY 为本地凭证
# - LLM_MODEL_A / LLM_MODEL_B 为两个可切换条目的实际模型名（可留空）
# 目录结构见 backend/config/models.yaml；密钥不得提交或发到 Issue/PR。
DATABASE_URL=
SESSION_SECRET=
UPLOAD_DIR=uploads
ALLOWED_ORIGINS=["http://localhost:5173"]
SESSION_TTL_DAYS=7
# False only for local HTTP; set true for an HTTPS deployment.
SESSION_COOKIE_SECURE=false
