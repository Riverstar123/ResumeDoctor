{
  "name": "resumedoctor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "vite --mode mock --host 127.0.0.1",
    "dev:api": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:mock": "tsc --noEmit && vite build --mode mock",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "types:generate": "openapi-typescript ../docs/api/openapi.json -o src/types/generated.ts",
    "types:check": "node scripts/check-types.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run types:check && npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
