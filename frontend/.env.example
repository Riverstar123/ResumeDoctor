# npm run dev defaults to mock; npm run dev:api / build defaults to http.
# Never place API keys or other secrets in VITE_* variables.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000
# Required before HTTP-mode consent: describe actual provider / data transmission.
VITE_PROCESSING_NOTICE=
